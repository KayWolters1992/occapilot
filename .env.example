# ── Occapilot configuratie ──────────────────────────────────────────
# Kopieer dit bestand naar .env.local en vul de waarden in.

# Claude API (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Postmark (postmarkapp.com) — één server met inbound + outbound streams
POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Het domein waar inbound mail binnenkomt (Postmark inbound domain of MX-forward)
INBOUND_DOMAIN=in.occapilot.nl

# Geheim voor sessie-cookies en reply-adres-handtekeningen (willekeurige lange string)
AUTH_SECRET=vervang-dit-door-een-lange-willekeurige-string

# Geheim waarmee de cron het verzend-endpoint aanroept
CRON_SECRET=vervang-dit-ook

# Pad naar de SQLite-database (map moet bestaan)
DATABASE_PATH=./data/occapilot.db

# Basis-URL van de app (voor links in meldingsmails)
APP_URL=http://localhost:3000
